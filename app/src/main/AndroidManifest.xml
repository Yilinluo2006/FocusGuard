<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" /> <!-- 允许应用访问后端网络接口 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <intent><action android:name="android.service.wallpaper.WallpaperService" /></intent>
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FocusGuardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusGuard"
        android:usesCleartextTraffic="true">
        <activity android:name=".WechatAuthActivity" android:exported="false" android:launchMode="singleTop" android:configChanges="orientation|screenSize" />
        <activity android:name=".wxapi.WXEntryActivity" android:exported="true" android:launchMode="singleTask"
            android:taskAffinity="${applicationId}" android:theme="@style/Theme.AppCompat.Translucent" />
        <service android:name=".CloudBackupJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity android:name=".DeviceSyncActivity" android:exported="false" />
        <service android:name=".DeviceSyncService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Synchronizes account settings, app usage statistics and sleep emergency use while user-enabled device synchronization is active." />
        </service>
        <receiver android:name=".StreakWidget" android:exported="false"
            android:label="奶蛙ToDo 连续坚持">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/streak_widget" />
        </receiver>
        <provider
            android:name=".LimitConfigProvider"
            android:authorities="${applicationId}.limits"
            android:exported="false" />
        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".PhoneAuthActivity" android:exported="false" />
        <activity android:name=".EmailBindingActivity" android:exported="false" />
        <!-- 注册邮箱验证页面，只允许应用内部打开 -->

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <!-- 注册忘记密码页面，只允许应用内部打开 -->

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".AppManageActivity"
            android:exported="false" />
        <activity android:name=".ProtectionRecoveryActivity" android:exported="false" />
        <activity android:name=".ProtectionDashboardActivity" android:exported="false" />
        <activity android:name=".PageMonitoringActivity" android:exported="false" />
        <activity android:name=".WallpaperGuardActivity" android:exported="false" />
        <activity
            android:name=".AccountBackupActivity"
            android:exported="false" />
        <activity
            android:name=".BlockedActivity"
            android:exported="false" />
        <activity android:name=".FocusModeActivity" android:exported="false"
            android:process=":guard" />

        <service
            android:name=".ProtectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":guard"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled app limit protection active after the UI task is removed." />
        </service>
        <!-- 前台保护服务提高进程优先级，划掉最近任务后仍继续检查受限应用 -->

        <service
            android:name=".FocusWallpaperService"
            android:label="奶蛙ToDo 壁纸守护"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER"
            android:process=":guard"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper"
                android:resource="@xml/focus_wallpaper" />
        </service>

        <receiver
            android:name=".ProtectionRestartReceiver"
            android:enabled="true"
            android:exported="false"
            android:process=":guard">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 开机或应用更新后，如果无障碍权限仍开启，就恢复保护服务 -->

        <service
            android:name=".FocusAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":guard"
            android:stopWithTask="false">

            <!-- 注册无障碍服务，只有系统可以绑定并启动它 -->

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
                <!-- 告诉系统：这是一个 AccessibilityService -->
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- 绑定刚刚创建的无障碍服务配置文件 -->
        </service>

        <activity
            android:name=".PermissionGuideActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
