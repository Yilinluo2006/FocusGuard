<?xml version="1.0" encoding="utf-8"?>
<!-- 首页界面 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvCurrentAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="本地模式 · 无需登录"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvCloudStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="使用本机配置"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:textSize="16sp" />
        <TextView android:id="@+id/tvStreak"
            android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:minHeight="64dp"
            android:gravity="center_vertical" android:text="— 天"
            android:textSize="18sp"
            android:textColor="@color/success_text" android:clickable="true"
            android:focusable="true" android:background="?attr/selectableItemBackground" />
        <LinearLayout
            android:id="@+id/usageSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/page_card_background"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="本机受限应用今日已用"
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvTodayUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:text="0 分钟"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <com.luoyilin.focusguard.RaisedButton
            android:id="@+id/btnManageApps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="管理应用限制"
            android:textColor="@color/on_primary"
            android:textSize="16sp" />

        <com.luoyilin.focusguard.RaisedButton
            android:id="@+id/btnUsagePermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/surface_background"
            android:text="查看必要设置  ›"
            android:textColor="@color/accent_text"
            android:textSize="16sp" />

        <com.luoyilin.focusguard.RaisedButton
            android:id="@+id/btnFocusMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="专注与睡眠计划"
            android:textColor="@color/on_primary"
            android:textSize="16sp" />

        <!-- 退出当前账号 -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/surface_background"
            android:text="账号与备份"
            android:textColor="@color/accent_text"
            android:textSize="16sp" />


        <Button android:id="@+id/btnAppearance"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="外观模式"
            android:backgroundTint="@color/secondary_surface"
            android:textColor="@color/text_primary" />
</LinearLayout>
</ScrollView>
