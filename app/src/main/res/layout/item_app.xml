<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="96dp" android:background="@drawable/page_card_background"
    android:foreground="?attr/selectableItemBackground"
    android:clipToOutline="true" android:focusable="true"
    android:layout_marginBottom="8dp"
    android:orientation="vertical" android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/ivAppIcon"
            android:layout_width="36dp" android:layout_height="36dp"
            android:importantForAccessibility="no" android:scaleType="fitCenter" />
        <TextView android:id="@+id/tvAppName"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp" android:maxLines="2" android:ellipsize="end"
            android:textColor="@color/text_primary" android:textSize="18sp"
            android:textStyle="bold" />
        <Switch android:id="@+id/swSelected"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:thumbTint="#FFFFFF" android:trackTint="@color/switch_track_tint" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvLimitTime"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="36dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary" android:textSize="14sp" />
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/accent_text"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/usageProgress"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:max="1000" android:indeterminate="false"
        android:importantForAccessibility="no"
        app:trackThickness="6dp" app:trackCornerRadius="3dp"
        app:trackColor="@color/secondary_surface"
        app:indicatorColor="@color/primary_button" />
</LinearLayout>
