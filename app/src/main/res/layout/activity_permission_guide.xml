<?xml version="1.0" encoding="utf-8"?>
<!-- 使用情况访问权限引导页面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="使用情况访问权限"
        android:textColor="#111827"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="正在检查权限..."
        android:textColor="#6B7280"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="FocusGuard 需要此权限来统计每个应用的每日使用时长，并判断应用是否超过限制时间。"
        android:textColor="#4B5563"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="开启步骤：&#10;1. 点击下方按钮&#10;2. 在列表中找到 FocusGuard&#10;3. 开启“允许使用情况访问”"
        android:textColor="#6B7280"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnOpenUsageSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#2563EB"
        android:text="前往系统设置"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
    <Button
        android:id="@+id/btnOpenAccessibilitySettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#111827"
        android:text="前往无障碍设置"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>