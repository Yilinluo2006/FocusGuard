<?xml version="1.0" encoding="utf-8"?>
<!-- FocusGuard 核心权限与服务引导页面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="权限与服务设置"
        android:textColor="#111827"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="正在检查使用情况访问..."
        android:textColor="#6B7280"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="此权限用于统计每个应用的每日使用时长，并判断是否达到限制。"
        android:textColor="#4B5563"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnOpenUsageSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2563EB"
        android:text="开启使用情况访问"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAccessibilityStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="正在检查强制限制服务..."
        android:textColor="#6B7280"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="此服务用于识别当前应用，并在达到限额后执行强制退出。"
        android:textColor="#4B5563"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnOpenAccessibilitySettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#111827"
        android:text="开启强制限制服务"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
