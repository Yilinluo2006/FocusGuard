<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="48dp">

        <!-- 注册邮箱验证页面标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="验证注册邮箱"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 告知用户验证码的接收位置和有效期 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="输入邮件中的 6 位验证码，验证后即可登录"
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <!-- 注册邮箱输入框，注册页传入时会自动填写 -->
        <EditText
            android:id="@+id/etVerificationEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:autofillHints="emailAddress"
            android:hint="注册邮箱"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/input_text"
            android:textColorHint="@color/input_hint"
            android:singleLine="true" />

        <!-- 请求后端重新发送注册邮箱验证码 -->
        <Button
            android:id="@+id/btnSendVerificationCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@android:color/transparent"
            android:text="获取验证码"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:textSize="15sp" />

        <!-- 输入邮件中收到的六位数字验证码 -->
        <EditText
            android:id="@+id/etVerificationCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="6 位验证码"
            android:inputType="number"
            android:maxLength="6"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/input_text"
            android:textColorHint="@color/input_hint"
            android:singleLine="true" />

        <!-- 提交邮箱和验证码完成验证 -->
        <Button
            android:id="@+id/btnVerifyEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#2563EB"
            android:text="完成验证"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- 网络请求期间显示加载状态 -->
        <ProgressBar
            android:id="@+id/progressEmailVerification"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- 关闭当前页面并返回登录页 -->
        <Button
            android:id="@+id/btnBackToLoginFromVerification"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/transparent"
            android:text="返回登录"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
