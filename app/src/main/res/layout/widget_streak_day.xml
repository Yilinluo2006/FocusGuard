<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weekDayRoot" android:layout_width="0dp"
    android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="vertical" android:gravity="center_horizontal">
    <TextView android:id="@+id/weekDayLabel" android:layout_width="match_parent"
        android:layout_height="20dp" android:gravity="center" android:textSize="11sp"
        android:textColor="#D8C9AA" android:maxLines="1" android:includeFontPadding="false" />
    <TextView android:id="@+id/weekDayMark" android:layout_width="24dp"
        android:layout_height="24dp" android:layout_marginTop="4dp"
        android:gravity="center" android:textSize="13sp" android:textStyle="bold"
        android:includeFontPadding="false" android:textColor="#FFFFFF"
        android:background="@drawable/streak_day_idle" />
</LinearLayout>
